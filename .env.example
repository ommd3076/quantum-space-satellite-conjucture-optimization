# GEMINI_API_KEY: Optional AI Studio key (unused by deterministic orbital simulation engine).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# PYTHON_SCIENCE_URL: URL of the separately runnable Python FastAPI scientific service.
PYTHON_SCIENCE_URL="http://127.0.0.1:8000"

# CELESTRAK_MIN_CACHE_AGE_SEC: Minimum local cache lifetime (seconds) respecting CelesTrak usage policy.
CELESTRAK_MIN_CACHE_AGE_SEC="7200"

# Optional user-authorized Space-Track.org credentials (NEVER hardcoded; leave empty if unused).
SPACETRACK_IDENTITY=""
SPACETRACK_PASSWORD=""
